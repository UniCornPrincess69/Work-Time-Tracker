<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkTimeTracker.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="24,40"
            Spacing="20">
            <!---Header-->
            <VerticalStackLayout
            Spacing="4"
            HorizontalOptions="Center">

                <Image
                Source="pickleclock.png"
                HeightRequest="110"
                WidthRequest="110"
                Aspect="AspectFit"/>

                <Label
                Text="Arbeitszeit Tracker"
                FontSize="28"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                TextColor="#1B5E20" />

                <Label
                    Text="Gurkentruppe Edition"
                    FontSize="14"
                    HorizontalTextAlignment="Center"
                    TextColor="#607D63"/>
            </VerticalStackLayout>

            <!--Current Status-->
            <Border
                BackgroundColor="White"
                Stroke="#D7E3D5"
                StrokeThickness="1"
                Padding="20"
                Margin="0,10,0,0">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>

                <VerticalStackLayout
                    Spacing="6"
                    HorizontalOptions="Center">

                    <Label
                        Text="Aktueller Status"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#78907A"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        x:Name="StatusLabel"
                        Text="Nicht beschäftigt"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="#424242"
                        HorizontalTextAlignment="Center"/>

                    <Label
                        x:Name="ElapsedTimeLabel"
                        Text="00:00:00"
                        FontSize="36"
                        FontAttributes="Bold"
                        TextColor="#1B5E20"
                        HorizontalTextAlignment="Center"/>
                </VerticalStackLayout>
            </Border>

            <!---Main actions-->
            <Grid
                ColumnDefinitions="*,*"
                ColumnSpacing="12">

                <Button
                x:Name="StartBtn"
                Grid.Column="0"
                Text="Start"
                HeightRequest="58"
                CornerRadius="18"
                FontSize="17"
                FontAttributes="Bold"
                BackgroundColor="#2E7D32"
                TextColor="White"
                Clicked="OnStartClicked"/>

                <Button
                x:Name="StopBtn"
                Grid.Column="1"
                Text="Stop"
                HeightRequest="58"
                CornerRadius="18"
                FontSize="17"
                FontAttributes="Bold"
                BackgroundColor="#D32F2F"
                TextColor="White"
                Clicked="OnStopClicked"/>

            </Grid>


            <Button
                 x:Name="OverviewBtn"
                 Text="Übersicht"
                 HeightRequest="52"
                 CornerRadius="18"
                 FontSize="16"
                 FontAttributes="Bold"
                 BackgroundColor="#0288D1"
                 TextColor="White"
                 Clicked="OnOverviewClicked"
                 Margin="0,4,0,0"/>


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
