<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WorkTimeTracker.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            
            <Label
                Text="Arbeitszeit Tracker"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level1" />
            
            <Image
                Source="pickleclock.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

                     
            <Button
                x:Name="StartBtn"
                Text="Start Tracking"
                BackgroundColor="Green"
                SemanticProperties.Hint="Begin tracking work time"
                Clicked="OnStartClicked"
                HorizontalOptions="Fill" />
            
            <Button
                x:Name="StopBtn"
                Text="Stop Tracking"
                BackgroundColor="Red"
                IsEnabled="False"
                SemanticProperties.Hint="Stop tracking work time"
                Clicked="OnStopClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="OverviewBtn"
                Text="Zeitübersicht"
                BackgroundColor="DeepSkyBlue"
                IsEnabled="True"
                SemanticProperties.Hint="Export Times in Excel file"
                Clicked="OnOverviewClicked"
                HorizontalOptions="Fill" />

            <Button
                x:Name="ExitBtn"
                Text="Beenden"
                Background="Black"
                TextColor="White"
                IsEnabled="True"
                SemanticProperties.Hint="End the application"
                Clicked="OnExitClicked"
                HorizontalOptions="Fill" />


        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
